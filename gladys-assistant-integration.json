{
  "manifest_version": 1,
  "type": "device",
  "name": "Luchtmeetnet",
  "description": {
    "en": "Official Dutch air quality (Luchtmeetnet): LKI index and pollutants of the stations, hourly.",
    "fr": "Qualité de l'air officielle des Pays-Bas (Luchtmeetnet) : indice LKI et polluants, heure par heure.",
    "de": "Offizielle Luftqualität der Niederlande (Luchtmeetnet): LKI-Index und Schadstoffe, stündlich.",
    "es": "Calidad del aire oficial de los Países Bajos (Luchtmeetnet): índice LKI y contaminantes, cada hora."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-luchtmeetnet:1.0.0",
  "gladys_version": ">=5.3.0",
  "countries": ["NL"],
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-luchtmeetnet/main/cover.png",
  "categories": ["environment"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Dutch air quality stations",
        "fr": "Stations néerlandaises de qualité de l'air",
        "de": "Niederländische Luftqualitätsstationen",
        "es": "Estaciones neerlandesas de calidad del aire"
      },
      "description": {
        "en": "Reads the official measuring stations of Luchtmeetnet (RIVM, DCMR, GGD Amsterdam and the provinces) through its open API (no account). Not affiliated with Luchtmeetnet nor RIVM.",
        "fr": "Lit les stations de mesure officielles de Luchtmeetnet (RIVM, DCMR, GGD Amsterdam et les provinces) par son API ouverte (sans compte). Non affilié à Luchtmeetnet ni au RIVM.",
        "de": "Liest die offiziellen Messstationen von Luchtmeetnet (RIVM, DCMR, GGD Amsterdam und die Provinzen) über die offene API (ohne Konto). Nicht mit Luchtmeetnet oder RIVM verbunden.",
        "es": "Lee las estaciones de medición oficiales de Luchtmeetnet (RIVM, DCMR, GGD Amsterdam y las provincias) mediante su API abierta (sin cuenta). Sin afiliación con Luchtmeetnet ni RIVM."
      },
      "links": [
        {
          "url": "https://www.luchtmeetnet.nl/stations/kaart",
          "label": {
            "en": "Map of the stations",
            "fr": "Carte des stations",
            "de": "Karte der Stationen",
            "es": "Mapa de las estaciones"
          }
        },
        {
          "url": "https://api-docs.luchtmeetnet.nl/",
          "label": {
            "en": "The Luchtmeetnet API",
            "fr": "L'API de Luchtmeetnet",
            "de": "Die Luchtmeetnet-API",
            "es": "La API de Luchtmeetnet"
          }
        }
      ]
    },
    {
      "key": "stations",
      "type": "string",
      "label": {
        "en": "Stations",
        "fr": "Stations",
        "de": "Stationen",
        "es": "Estaciones"
      },
      "description": {
        "en": "The numbers of the Luchtmeetnet stations to read, separated by commas (10 at most). The \"Find a station\" button below gives them, by name or around a house.",
        "fr": "Les numéros des stations Luchtmeetnet à lire, séparés par des virgules (10 au plus). Le bouton « Trouver une station » ci-dessous les donne, par nom ou autour d'une maison.",
        "de": "Die Nummern der zu lesenden Luchtmeetnet-Stationen, durch Kommas getrennt (höchstens 10). Der Button „Station finden“ unten liefert sie, nach Name oder in der Nähe eines Hauses.",
        "es": "Los números de las estaciones de Luchtmeetnet que desea leer, separados por comas (10 como máximo). El botón «Buscar una estación» más abajo se los da, por nombre o alrededor de una casa."
      },
      "placeholder": {
        "en": "e.g. NL49014, NL10938",
        "fr": "ex. NL49014, NL10938",
        "de": "z. B. NL49014, NL10938",
        "es": "p. ej. NL49014, NL10938"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "refresh_minutes",
      "type": "select",
      "label": {
        "en": "Refresh",
        "fr": "Relevé",
        "de": "Abruf",
        "es": "Lectura"
      },
      "description": {
        "en": "Luchtmeetnet publishes hourly values, a little after each hour.",
        "fr": "Luchtmeetnet publie des valeurs horaires, un peu après chaque heure.",
        "de": "Luchtmeetnet veröffentlicht Stundenwerte, kurz nach jeder vollen Stunde.",
        "es": "Luchtmeetnet publica valores horarios, poco después de cada hora."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "30",
          "label": {
            "en": "Every 30 minutes",
            "fr": "Toutes les 30 minutes",
            "de": "Alle 30 Minuten",
            "es": "Cada 30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "Every hour",
            "fr": "Toutes les heures",
            "de": "Jede Stunde",
            "es": "Cada hora"
          }
        }
